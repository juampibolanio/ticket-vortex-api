# ==============================================================================
# TicketVortex API - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Adjust the values below according to your environment (dev or prod).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Profile Settings
# ------------------------------------------------------------------------------
# Active Spring Profile: 'dev' (development) or 'prod' (production)
SPRING_PROFILES_ACTIVE=dev

# Server HTTP Port
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticketvortexdb
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_URL=jdbc:postgresql://localhost:5432/ticketvortexdb

# HikariCP Connection Pool
# Recommended: dev (5 max, 2 min), prod (20 max, 5 min)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 3. JWT Security Settings (HMAC-SHA-256)
# ------------------------------------------------------------------------------
# Secret key: MUST be at least 256 bits (32+ alphanumeric characters).
# Example generated with openssl rand -base64 32:
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Token Expiration in milliseconds (3600000 = 1 hour)
JWT_EXPIRATION=3600000

# Token Renewal / Refresh window in milliseconds (604800000 = 7 days)
JWT_RENEW_TIME=604800000

# ------------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Use '*' only in local dev if necessary.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 5. Swagger / OpenAPI Documentation
# ------------------------------------------------------------------------------
# Always enabled in 'dev'. Set to 'true' if you want Swagger UI exposed in 'prod'.
SWAGGER_ENABLED=true