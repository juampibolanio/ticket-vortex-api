# ==============================================================================
# TicketVortex API - Production Environment Preset (.env.prod.example)
# ==============================================================================
# To use: copy this to .env on your production server / CI/CD pipeline:
#   cp .env.prod.example .env
# ==============================================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Database Configuration (Production PostgreSQL or Managed RDS / Cloud SQL)
DB_HOST=db.production.internal
DB_PORT=5432
DB_NAME=ticketvortex_prod
DB_USER=ticketvortex_app
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=require

# HikariCP Pool (Optimized for high-concurrency production load)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# JWT Secret: MUST be securely generated (openssl rand -base64 48)
JWT_SECRET=REPLACE_WITH_STRONG_PRODUCTION_SECRET_MIN_256_BITS
JWT_EXPIRATION=3600000
JWT_RENEW_TIME=604800000

# CORS: Set exclusively to your production domains / frontend URLs
CORS_ALLOWED_ORIGINS=https://ticketvortex.com,https://app.ticketvortex.com

# Swagger UI in Production: false for maximum security (or true if public API docs desired)
SWAGGER_ENABLED=false
