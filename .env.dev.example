# ==============================================================================
# TicketVortex API - Development Environment Preset (.env.dev.example)
# ==============================================================================
# To use: copy this to .env:
#   cp .env.dev.example .env
# ==============================================================================

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Configuration (Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticketvortexdb
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/ticketvortexdb

# HikariCP Pool (Lightweight for local development)
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=2

# JWT Secret for local development
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=3600000
JWT_RENEW_TIME=604800000

# CORS: Frontend development servers (Vite, Next.js, React)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Swagger enabled
SWAGGER_ENABLED=true
